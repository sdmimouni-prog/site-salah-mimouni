# Books only: server-side Resend credentials. Never commit secrets.
# Contact and podcast subscriptions use FormSubmit, with no API key.
RESEND_API_KEY=
# Sender must belong to a domain verified in the transactional email provider.
BOOK_ORDERS_FROM=
# All form recipients are fixed to sd.mimouni@richmedia.ma in src/content/contact.ts.
# Use the exact public origin in production. Local preview can use this:
SITE_URL=http://127.0.0.1:3009
# Public canonical origin for SEO (independent of form origin validation).
# Replace with the final custom domain when it is configured, then rebuild.
NEXT_PUBLIC_SITE_URL=https://site-salah-mimouni.vercel.app
# Local visual preview only. Leave false/absent for production: hides all unverified content.
PODCASTS_PREVIEW=false
