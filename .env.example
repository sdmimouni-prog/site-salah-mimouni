# Server-only. Copy to .env.local and set a real key; never commit secrets.
RESEND_API_KEY=
# Sender must belong to a domain verified in the transactional email provider.
BOOK_ORDERS_FROM=
# Optional contact sender override; otherwise CONTACT uses BOOK_ORDERS_FROM.
CONTACT_FROM=
BOOK_ORDERS_TO=sd.mimouni@richmedia.ma
# Use the exact public origin in production. Local preview can use this:
SITE_URL=http://127.0.0.1:3009
# Local visual preview only. Leave false/absent for production: hides all unverified content.
PODCASTS_PREVIEW=false
